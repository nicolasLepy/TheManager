<UserControl x:Class="ui.controls.ControlMatchIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ui.controls"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="200">
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.2*"/>
			<ColumnDefinition Width="0.2*"/>
			<ColumnDefinition Width="0.2*"/>
			<ColumnDefinition Width="0.2*"/>
			<ColumnDefinition Width="0.2*"/>
		</Grid.ColumnDefinitions>
		<Image x:Name="imageHome" Grid.Column="0" Style="{StaticResource image}" HorizontalAlignment="Center" Width="25"/>
		<TextBlock x:Name="textHome" Grid.Column="1" Text="DFCO" Style="{StaticResource textPlainCenter}" FontWeight="Bold"/>
		<Border x:Name="borderScore" Grid.Column="2" Background="Transparent">
			<TextBlock x:Name="textScore" Text="2-0" Style="{StaticResource textPlainCenter}" FontWeight="ExtraBold"/>
		</Border>
		<TextBlock x:Name="textAway" Grid.Column="3" Text="ESTAC" Style="{StaticResource textPlainCenter}" FontWeight="Bold"/>
		<Image x:Name="imageAway" Grid.Column="4" Style="{StaticResource image}" HorizontalAlignment="Center" Width="25"/>
	</Grid>
</UserControl>
