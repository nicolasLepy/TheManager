<UserControl x:Class="TheManager_GUI.controls.ControlScoreboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheManager_GUI.controls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="600">

	<Border Padding="10">
		<Border.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="{StaticResource colorPrimary2}" Offset="0"/>
				<GradientStop Color="{StaticResource colorSecondary1}" Offset="1"/>
			</LinearGradientBrush>
		</Border.Background>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="0.75*"/>
				<RowDefinition Height="0.25*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="0.1*"/>
				<ColumnDefinition Width="0.3*"/>
				<ColumnDefinition Width="0.1*"/>
				<ColumnDefinition Width="0.1*"/>
				<ColumnDefinition Width="0.1*"/>
				<ColumnDefinition Width="0.3*"/>
				<ColumnDefinition Width="0.1*"/>
			</Grid.ColumnDefinitions>
			<Border x:Name="borderTime" CornerRadius="10,10,10,10" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="{StaticResource colorHighlight1}" Offset="0"/>
						<GradientStop Color="{StaticResource colorHighlight1}" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<TextBlock x:Name="tbExtraText" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="" Style="{StaticResource textBig}" HorizontalAlignment="Center"/>
			<TextBlock x:Name="tbTime" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Text="93:01" Style="{StaticResource textBig}" HorizontalAlignment="Center"/>
			<TextBlock x:Name="tbExtraTime" Grid.Row="1" Grid.Column="4" Text="+2" Style="{StaticResource textBig}" Background="{StaticResource colorNegative}" HorizontalAlignment="Center"/>
			<Image x:Name="imageHome"  Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource image}" HorizontalAlignment="Center" Width="100"/>
			<TextBlock x:Name="tbHome" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="DIJON FCO" Style="{StaticResource textBig}" HorizontalAlignment="Left" Margin="10" TextWrapping="Wrap"/>
			<TextBlock x:Name="tbAway" Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Text="ESTAC" Style="{StaticResource textBig}" HorizontalAlignment="Right" Margin="10" TextWrapping="Wrap"/>
			<Image x:Name="imageAway" Grid.Row="0" Grid.RowSpan="2" Grid.Column="6" Style="{StaticResource image}" HorizontalAlignment="Center" Width="100"/>
			<TextBlock x:Name="tbScoreHome" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2" Text="3" Style="{StaticResource textScore}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
			<TextBlock x:Name="tbScoreAway" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" Text="3" Style="{StaticResource textScore}" HorizontalAlignment="Right" ClipToBounds="False"/>
		</Grid>
	</Border>


</UserControl>
