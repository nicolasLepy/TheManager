<Window x:Class="TheManager_GUI.LiveGameView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tm="clr-namespace:TheManager_GUI.Styles"
        xmlns:local="clr-namespace:TheManager_GUI"
		xmlns:uc="clr-namespace:TheManager_GUI.controls"
        mc:Ignorable="d"
		Background="Transparent"
		WindowStartupLocation="CenterScreen"
		AllowsTransparency="True"
		WindowStyle="None"
        Title="LiveGameView" Height="900" Width="1900">

	<Border CornerRadius="5" BorderThickness="1">

		<Border.BorderBrush>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="{StaticResource colorViewBorder1}" Offset="0"/>
				<GradientStop Color="{StaticResource colorViewBorder2}" Offset="0.5"/>
				<GradientStop Color="{StaticResource colorViewBorder3}" Offset="1"/>
			</LinearGradientBrush>
		</Border.BorderBrush>
		<Grid>

			<Grid.ColumnDefinitions>
				<!--Navigation menu-->
				<ColumnDefinition Width="215"/>
				<!--Content section-->
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Navigation menu -->
			<Border CornerRadius="10,0,0,10"
                    Grid.Column="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
						<GradientStop Color="{StaticResource colorSecondary1}" Offset="0"/>
						<GradientStop Color="{StaticResource colorSecondary2}" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="0.15*"/>
						<RowDefinition Height="0.25*"/>
						<RowDefinition Height="0.2*"/>
						<RowDefinition Height="0.4*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Margin="15">
						<!--Menu Buttons-->
						<Button x:Name="buttonStart" Style="{StaticResource buttonIconMenu}" tm:TMButtonProperties.Image="icons/start.png" Content="{StaticResource str_start}" Click="buttonStart_Click"/>
						<Button x:Name="buttonQuit" IsEnabled="False"  Style="{StaticResource buttonIconMenu}" tm:TMButtonProperties.Image="icons/quit.png" Content="{StaticResource str_quit}" Click="buttonQuit_Click"/>
					</StackPanel>

					<StackPanel Grid.Row="1" Margin="15">
						<Image x:Name="imageTournament" Style="{StaticResource image}" Height="150"/>
						<TextBlock x:Name="tbTournament" Style="{StaticResource textSecondary}" HorizontalAlignment="Center" Text="Ligue 1" Margin="0, 15, 0, 35"/>
					</StackPanel>

					<!-- Game details -->
					<Grid x:Name="gridGameDetails" Grid.Row="2" Margin="15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.2*"/>
							<ColumnDefinition Width="0.8*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="0.2*"/>
							<RowDefinition Height="0.2*"/>
							<RowDefinition Height="0.2*"/>
							<RowDefinition Height="0.2*"/>
						</Grid.RowDefinitions>
						<Image Grid.Row="0" Grid.Column="0" Style="{StaticResource image}" Source="icons/stadium.png" Height="75"/>
						<TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbStadium" Style="{StaticResource textSecondary}" Text="First Last" TextWrapping="Wrap" Margin="10, 0, 0, 0"/>
						<TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbAttendance" Style="{StaticResource textSecondary}" Text="145M" Margin="10, 0, 0, 0"/>
						<Image Grid.Row="2" Grid.Column="0" Style="{StaticResource image}" Source="icons/calendar.png" Height="75"/>
						<TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbGameDate" Style="{StaticResource textSecondary}" Text="31/12/2025" Margin="10, 0, 0, 0"/>
						<TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbGameTime" Style="{StaticResource textSecondary}" Text="00:00" Margin="10, 0, 0, 0"/>
					</Grid>

					<!-- Simulation panel -->
					<Grid x:Name="gridMedias" Grid.Row="3" VerticalAlignment="Bottom" Margin="15">
						<Grid.RowDefinitions>
							<RowDefinition Height="0.5*"/>
							<RowDefinition Height="0.5*"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.2*"/>
							<ColumnDefinition Width="0.6*"/>
							<ColumnDefinition Width="0.2*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{StaticResource str_simulationSpeed}" Style="{StaticResource textSecondary}" HorizontalAlignment="Center"/>
						<TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource str_slow}" FontSize="10" Style="{StaticResource textPlain}" HorizontalAlignment="Right"/>
						<Slider Grid.Row="1" Grid.Column="1" Name="sliderSpeed" Minimum="0" Maximum="100" Value="20" TickPlacement="BottomRight" TickFrequency="10" />
						<TextBlock Grid.Row="1" Grid.Column="2" Text="{StaticResource str_fast}" FontSize="10" Style="{StaticResource textPlain}"/>

					</Grid>

				</Grid>

			</Border>

			<!-- Main Section -->
			<Border CornerRadius="0, 5, 5, 0"
					Grid.Column="1">
				<Border.Background>
					<LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
						<GradientStop Color="{StaticResource colorPrimary1}" Offset="0"/>
						<GradientStop Color="{StaticResource colorPrimary2}" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="15"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- Main Window : Drag/Drop Zone -->
					<StackPanel x:Name="spControlBar" Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Background="Transparent"
								MouseLeftButtonDown="spControlBar_MouseLeftButtonDown"
								MouseEnter="spControlBar_MouseEnter">

					</StackPanel>
					
					<!-- Main Window : Main Panel -->
					<Grid Grid.Row="1" x:Name="gridMain">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0.45*"/>
							<ColumnDefinition Width="0.075*"/>
							<ColumnDefinition Width="0.15*"/>
							<ColumnDefinition Width="0.15*"/>
							<ColumnDefinition Width="0.175*"/>
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0" Background="Transparent">
							<Grid.RowDefinitions>
								<RowDefinition Height="0.25*"/>
								<RowDefinition Height="0.15*"/>
								<RowDefinition Height="0.5*"/>
								<RowDefinition Height="0.1*"/>
							</Grid.RowDefinitions>
							<uc:ControlScoreboard Grid.Row="0" x:Name="ucScoreboard" Height="200" Margin="10"/>
							<uc:ControlStats Grid.Row="1" x:Name="ucStats" Margin="10"/>
							<Grid Grid.Row="2" x:Name="gridLineups">
								<Grid.RowDefinitions>
									<RowDefinition Height="0.8*"/>
									<RowDefinition Height="0.2*"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.6*"/>
									<ColumnDefinition Width="0.2*"/>
									<ColumnDefinition Width="0.6*"/>
								</Grid.ColumnDefinitions>
							</Grid>
							<Grid Grid.Row="3" x:Name="gridGameActions">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="0.2*"/>
									<ColumnDefinition Width="0.2*"/>
									<ColumnDefinition Width="0.7*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" x:Name="tbActionTime" Style="{StaticResource textTitle}" HorizontalAlignment="Right"/>
								<Image Grid.Column="1" x:Name="imageActionClub" Style="{StaticResource image}" Height="45"/>
								<TextBlock Grid.Column="2" TextWrapping="Wrap" x:Name="tbActionDesc" Style="{StaticResource textSecondary}"/>
							</Grid>
						</Grid>

						<Grid Grid.Column="2">
							<Grid.RowDefinitions>
								<RowDefinition Height="0.1*"/>
								<RowDefinition Height="0.9*"/>
							</Grid.RowDefinitions>
							<Image Grid.Row="0" Style="{StaticResource image}" Source="icons/ranking.png" Height="75"/>
							<StackPanel Grid.Row="1" Orientation="Vertical" Background="Transparent" x:Name="layoutRanking" Margin="10">
							</StackPanel>
						</Grid>

						<Grid Grid.Column="3">
							<Grid.RowDefinitions>
								<RowDefinition Height="0.1*"/>
								<RowDefinition Height="0.9*"/>
							</Grid.RowDefinitions>
							<Image Grid.Row="0" Style="{StaticResource image}" Source="icons/calendar.png" Height="75"/>
							<StackPanel Grid.Row="1" Orientation="Vertical" Background="Transparent" x:Name="layoutScores" Margin="10">
							</StackPanel>
						</Grid>

						<Grid Grid.Column="4">
							<Grid.RowDefinitions>
								<RowDefinition Height="0.1*"/>
								<RowDefinition Height="0.9*"/>
							</Grid.RowDefinitions>
							<Image Grid.Row="0" Style="{StaticResource image}" Source="icons/calendar.png" Height="75"/>
							<StackPanel Grid.Row="1" Orientation="Vertical" Background="Transparent" x:Name="layoutEvents" Margin="10">
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
			</Border>

		</Grid>

	</Border>


</Window>